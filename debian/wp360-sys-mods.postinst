#!/bin/bash

case $1 in
  configure)
    dpkg-trigger update-initramfs
    sed -i 's/update_initramfs=yes/update_initramfs=all/' /etc/initramfs-tools/update-initramfs.conf
    ;;
  triggered)
    if [[ -f "$2" ]]
    then
      crtime=$(stat -c '%W' "$2")
      mtime=$(stat -c '%Y' "$2")
      if [[ "$crtime" -ge "$mtime" ]] && ! grep -q '\[SysCom\]' "$2"
      then
        cat >> "$2" <<- \EOF

[SysCom]
Linux.Devicefile.2=/dev/ttyWP360-2
Linux.Devicefile.3=/dev/ttyWP360-3
Linux.Devicefile.4=/dev/ttyWP360-4

[SysFile]
PlaceholderFilePath.1=/media/root,$DRIVES$
PlaceholderFilePath.1.Volatile=1
EOF
      fi
    fi
    ;;
esac
